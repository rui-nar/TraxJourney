# TraxJourney — server runtime environment variables.
#
# These are read by the FastAPI backend at RUNTIME (os.getenv), NOT at build
# time. A value passed to `docker build` or to `flutter build` does NOT reach
# the running server — it must be in the container's (or shell's) environment
# when the process starts.
#
# Copy this file to `.env` and fill in the blanks. The real `.env` is
# gitignored — never commit secrets.
#
#   Local dev (manual uvicorn):
#     export $(grep -v '^#' .env | xargs) && uvicorn api.router:app --reload
#   Local dev (Windows):
#     dev.ps1 / dev-server.ps1 already inject these for you.
#   Docker / NAS:
#     reference this file from docker-compose.yml ->  env_file: .env
#     then `docker compose up -d` to (re)create the container so it picks the
#     new values up (a plain `restart` does NOT apply env changes).

# ── Required ──────────────────────────────────────────────────────────────────

# Session signing key. The server REFUSES TO START without it (issue #156).
#
# It signs and verifies every login token, and the token says whether you are an
# admin — so anyone who knows this value can mint a token for any account on
# your instance. There is deliberately no default: a fallback shipped in a
# public repository would be a working key on every install that never set one.
#
# Generate your own, and never reuse one between deployments:
#   openssl rand -hex 32
#
# Changing it invalidates every issued token — all users have to sign in again.
JWT_SECRET=

# ── Integrations ──────────────────────────────────────────────────────────────

# Strava OAuth app credentials. Create the app at
# https://www.strava.com/settings/api; these take priority over
# config/config.json's strava.client_id / strava.client_secret. Without them
# the /api/strava/* endpoints still exist but every connect attempt fails at
# Strava's end — activity import is the app's main data source, so in practice
# these are required for anything but a manual-entry-only instance.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where Strava sends the user back after they authorise. Defaults to
# http://localhost:8000/api/strava/callback, which is right for local dev only.
#
# Two places must agree or the OAuth round-trip breaks: this value, and the
# "Authorization Callback Domain" of the Strava app (the domain only — Strava
# stores no path). A mismatch surfaces as an error page on Strava's site, with
# nothing in this app's logs, because the user never gets redirected back.
STRAVA_REDIRECT_URI=

# How long a user's fetched activity list stays cached, in seconds. Default
# 3600. Strava allows 100 requests per 15 minutes and 1000 per day for the
# whole application — not per user — so lowering this on an instance with
# several users is how you exhaust the quota for all of them at once.
STRAVA_CACHE_TTL=3600

# Mapbox access token — used two ways:
#   1. CLIENT BUILD-TIME define used by the dev scripts (dev.ps1 /
#      dev-client.ps1) as `--dart-define=MAPBOX_TOKEN=...`, bundled into the
#      Flutter web build for the interactive map.
#   2. SERVER RUNTIME (os.getenv, issue #14): read by src/poster/tile_stitcher.py
#      to fetch raster tiles for poster basemap generation. Falls back to
#      config/config.json's mapbox.token when unset.
MAPBOX_TOKEN=

# Google Translate v2 API key — enables the memory translation endpoints.
# When unset, the server logs a warning and /api/memories/.../translate fails
# at runtime. Optional (translation is the only feature affected).
GOOGLE_TRANSLATE_API_KEY=

# Google OAuth client id for "Sign in with Google". Takes priority over
# config/config.json's google.client_id. Optional if that file provides it.
GOOGLE_CLIENT_ID=

# SQLAlchemy database URL. Empty means the default: a local sqlite file,
# traxjourney.db, in the working directory. The server refuses to start on
# that default next to an old viewtripweb.db (the default before the rename)
# rather than open a new, empty database — rename the file or set this.
# Example: sqlite:////data/traxjourney.db
DATABASE_URL=

# Transactional email (issue #113) — any provider's SMTP relay works (Brevo,
# Resend, SES, Postmark, ...); switching providers is just changing these.
# All optional: when SMTP_HOST is unset, the server logs emails to the
# console instead of sending them, so it never fails to start without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From address. Falls back to SMTP_USERNAME when unset.
#
# Must be on a domain verified with the provider and carrying the SPF/DKIM
# records it issues. A From address on an unverified domain is accepted by the
# relay and then dropped or spam-filed by the recipient — which looks exactly
# like "the invite never arrived", with nothing in this app's logs to show for
# it, since the send itself succeeded.
MAIL_FROM=

# Base URL used to build links in outgoing mail — invite links (issue #113)
# and email-verification links (issue #110). Must be the address users reach
# the app at; a wrong value produces mail whose links go nowhere.
FRONTEND_ORIGIN=

# Prometheus scrape token (issue #125). Generate with `openssl rand -hex 32`.
# Scrapers authenticate as `Authorization: Bearer <token>`; see docs/METRICS.md.
# LEAVE EMPTY to disable /metrics entirely — the reverse proxy forwards every
# path to this app, so an unauthenticated endpoint would be world-readable.
#
# If the `alloy` service (docs/DEPLOYMENT_VPS.md's Observability section) is
# running, it needs this same value to scrape /metrics at all — confirmed
# live: without it, every scrape 401s and no traxjourney_* app metrics ever
# reach Prometheus. Nothing extra to configure beyond setting this — .env
# already reaches the alloy container the same way it reaches this one.
METRICS_TOKEN=

# ── Billing / tier plans (issue #121) ─────────────────────────────────────────
# ALL OPTIONAL. Leave every variable below empty and this deployment sells
# nothing: the billing endpoints 404, no paywall exists, and every account gets
# unlimited trips, storage and trip length. That is the intended state for
# self-hosting — TraxJourney is MIT-licensed and self-hosters are never metered.
# Setting these is what turns a deployment into the hosted service.
# See docs/BILLING.md.

# Master switch. Unset → inferred from STRIPE_SECRET_KEY. "0"/"false" forces
# billing off even when Stripe keys are present (useful for a staging copy).
BILLING_ENABLED=

# Whether exceeding a plan limit BLOCKS the request (402) or is merely counted.
# Off by default on purpose: turn billing on first, watch real usage, and only
# then start refusing writes — otherwise accounts that grew before the limits
# existed are locked out on the day you deploy.
BILLING_ENFORCE_QUOTAS=

# Stripe. Secret key, webhook signing secret (`whsec_...`), and one recurring
# price id per paid tier.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price ids are now OPTIONAL (issue #154). Leave them blank and the server
# resolves each tier's price by its lookup key (`traxjourney_tier_N_monthly_eur`),
# which scripts/stripe_catalog.py stamps on every price it creates. Lookup keys
# are ours, so the same blank config is correct in a sandbox, in test mode and in
# live — whereas a `price_...` id is scoped to ONE account, and pairing it with a
# key from another silently grants the wrong tier or fails checkout outright.
#
# Set one only to pin a specific price, or as an escape hatch: an explicit value
# always wins over resolution.
STRIPE_PRICE_TIER_1=
STRIPE_PRICE_TIER_2=
STRIPE_PRICE_TIER_3=

# Plan limits. Blank = the built-in defaults shown here. "unlimited" removes
# the limit. Storage is in MB; trip days are the calendar length of one trip,
# first day to last inclusive (empty days in between count).
FREE_MAX_PROJECTS=1
FREE_MAX_STORAGE_MB=500
FREE_MAX_TRIP_DAYS=10

TIER_1_MAX_PROJECTS=2
TIER_1_MAX_STORAGE_MB=5120
TIER_1_MAX_TRIP_DAYS=100

TIER_2_MAX_PROJECTS=10
TIER_2_MAX_STORAGE_MB=20480
TIER_2_MAX_TRIP_DAYS=365

TIER_3_MAX_PROJECTS=unlimited
TIER_3_MAX_STORAGE_MB=51200
TIER_3_MAX_TRIP_DAYS=unlimited

# What the pricing UI displays. Purely cosmetic — the amount actually charged is
# whatever the Stripe price is configured for. Names are overridable too, so the
# tiers can be renamed without a release.
FREE_NAME=
TIER_1_NAME=
TIER_2_NAME=
TIER_3_NAME=
TIER_1_PRICE_LABEL=
TIER_2_PRICE_LABEL=
TIER_3_PRICE_LABEL=

# SHA-256 fingerprint(s) of the Android release signing certificate (issue #136).
# Serves /.well-known/assetlinks.json, which is what makes share/join/verify
# links open in the Android app instead of a browser. Comma-separate to list
# several during a key rotation. Printed by scripts/new-android-keystore.ps1;
# see docs/ANDROID.md. LEAVE EMPTY on an instance with no Android app — the
# endpoint then 404s rather than publishing an empty, un-verifiable statement.
ANDROID_CERT_FINGERPRINTS=

# ── Rail geometry source (issue #345) ─────────────────────────────────────────
# Where train route geometry is read from: "overpass" (default) or "local".
#
# Overpass is the public OpenStreetMap query API. It is a free service with a
# fair-use policy, and resolving a route asks it several large questions — which
# is how this deployment's IP came to be banned outright. "local" reads the same
# data from per-region SQLite stores built by the rail-extract pipeline, so a
# European route costs no requests at all.
#
# Leave EMPTY (or "overpass") unless RAIL_DATA_DIR below holds the built stores:
# with the flag set and no usable data, every resolve simply falls back to
# Overpass, which is the traffic this exists to avoid. Install the data FIRST
# (see RAIL_DATA_DIR), then set this.
#
# Overpass remains the fallback either way — outside the built regions, and
# whenever the local data yields no route.
RAIL_SOURCE=

# Directory holding the per-region stores and their manifest.json. Required
# when RAIL_SOURCE=local. Point it at a mounted volume, NOT at a path inside
# the image: the data is refreshed on its own schedule (monthly is ample) and
# must not need a release to update.
#
# NOTHING CREATES THIS DIRECTORY FOR YOU. The data does not ship in the image
# and no container fetches it at boot — a deployment step puts it there:
#
#   docker compose run --rm --entrypoint python traxjourney \
#       scripts/fetch_rail_data.py --dest /app/data/rail
#
# That downloads the rail-only country extracts from the newest `rail-data-*`
# prerelease on GitHub (public, so no token), checks each one against the
# manifest's sha256, builds the SQLite store and moves it into place. Re-run it
# to refresh; it re-fetches only the regions whose checksum changed. The full
# procedure, including rollback, is in docs/DEPLOYMENT_VPS.md, "Rail data".
#
# Refreshing needs no restart: each process rebuilds its view of this directory
# at most every 5 minutes, so a refresh — new manifest and new store files
# alike — is live within that window. Nor can a refresh be caught half-done:
# every file is written elsewhere and moved in with an atomic rename, so a
# reader either sees the whole old file or the whole new one, and a resolve
# holding a store open when it is replaced finishes against the data it
# started on.
#
# Use a path on the mounted volume (./data is already mounted in
# docker-compose.yml.example), and give it ~1 GB for the whole of Europe.
#
#   RAIL_DATA_DIR=/app/data/rail
RAIL_DATA_DIR=

# ── Background job queue (issue #173) ─────────────────────────────────────────
# Redis connection for the job queue. OPTIONAL: leave EMPTY and every background
# job (route resolution, poster rendering, share tiles, stats) runs in the API
# process via FastAPI BackgroundTasks — the original behaviour, and the
# supported setup for a small self-hosted instance.
#
# Set it and those jobs are queued instead, which buys two things:
#   * durability — a job survives an API restart, instead of vanishing and
#     leaving e.g. a segment stuck on "calculating route" forever;
#   * a real concurrency bound — Overpass rate-limits per IP, and the number of
#     worker processes on the `resolve` queue is what caps parallel lookups.
#     Raising it is a decision about load on a free public API.
#
# Requires the `worker` service (see docs/DEPLOYMENT_VPS.md). Unsetting this is
# the rollback path: no image rebuild, jobs simply run in-process again.
#
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Which role this process plays: "api" (default) or "worker". Only the API
# process runs migrations, the admin seed and the scheduled jobs (WAL
# checkpoint, nightly backup, usage reconcile) — a worker that also ran them
# would double every schedule and race `alembic upgrade head` at boot. The
# worker image sets this itself; you should not need to.
TRAXJOURNEY_ROLE=

# Directory where every process writes Prometheus samples, so /metrics can
# aggregate across them. Only needed when you scrape metrics AND run the worker
# service — otherwise a scrape sees the API process only and job-side DB metrics
# silently go missing. Must be a path both containers mount. Leave EMPTY when
# there is no worker (the default single-process registry is then complete).
#
#   PROMETHEUS_MULTIPROC_DIR=/app/metrics
PROMETHEUS_MULTIPROC_DIR=

# ── Observability shipper (optional, issue #205) ───────────────────────────────
# Read by config/alloy-config.river's env() calls — only used by the optional
# `alloy` service in docker-compose.yml.example. Ships this host's container
# logs + app metrics to Loki/Prometheus colocated on the NAS over a Tailscale
# tunnel (never the public internet). Leave both EMPTY to run without it — see
# docs/OBSERVABILITY.md and docs/DEPLOYMENT_VPS.md's "Observability" section.
#
#   LOKI_PUSH_URL=http://<nas-tailscale-host>:3100/loki/api/v1/push
LOKI_PUSH_URL=

#   PROMETHEUS_REMOTE_WRITE_URL=http://<nas-tailscale-host>:9090/api/v1/write
PROMETHEUS_REMOTE_WRITE_URL=

# Stamped onto every log line and metric this host's alloy ships, as the
# `env` label — REQUIRED once LOKI_PUSH_URL/PROMETHEUS_REMOTE_WRITE_URL are
# set. Prod and val run this same compose stack on the same VPS and push to
# the same NAS Loki/Prometheus (docs/DEPLOYMENT_VPS.md §5); without this,
# their data is indistinguishable once it lands there. "production" on
# /opt/traxjourney, "validation" on /opt/traxjourney-val — do not reuse a value
# across environments.
#
#   TRAXJOURNEY_ENV=production
TRAXJOURNEY_ENV=
