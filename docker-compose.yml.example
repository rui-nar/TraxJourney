# TraxJourney — example Docker Compose deployment.
#
# The real `docker-compose.yml` is gitignored because it has historically held
# secrets inline. This example keeps them in `.env` instead (copy `.env.example`
# and fill it in), so the file itself is safe to read, diff and version.
#
#   cp docker-compose.yml.example docker-compose.yml
#   cp .env.example .env      # then fill in the blanks
#   docker compose up -d
#
# Note `docker compose restart` does NOT pick up `.env` changes — the container
# has to be recreated (`up -d`) for new environment values to apply.

# Every service below gets the same log-rotation policy (issue #205): Docker's
# default json-file driver has no cap at all, and this is the fallback of last
# resort if the observability stack (docs/OBSERVABILITY.md) or its VPS→NAS
# tunnel is down during an incident — `docker compose logs` needs to still
# answer "what just happened" without having silently filled the disk between
# now and whenever that last happened. 20m × 5 files = 100MB/service ceiling;
# adjust if your traffic warrants more history.
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "20m"
    max-file: "5"

# Memory ceilings (issue #209): before this, nothing here bounded a
# container's memory use below the whole host's. A single overloaded route
# resolution was free to consume all available RAM; with no swap configured
# on a host (docs/DEPLOYMENT_VPS.md), that produced a multi-hour system-wide
# lockup rather than a clean, single-container OOM-kill Docker could recover
# from on its own via `restart: unless-stopped`.
#
# The first cut of these numbers (512M/384M) was a guess and was too low: a
# resolve on a small test project pushed the API process past 512M and got
# cgroup-OOM-killed (`journalctl -k`: "Memory cgroup out of memory: Killed
# process ... (uvicorn) ... anon-rss:521900kB", still climbing when killed —
# see issue #209's follow-up comment). These are revised upward from that
# measurement, with headroom, not from a second guess.
#
# REQUIRES REDIS_URL to be set. Without it, `enqueue()` (src/jobs/queue.py)
# falls back to running resolves in-process in the API container, which is
# the smallest limit here — the exact way the 512M version broke. `worker`
# is sized closest to the measured resolve peak; `worker-poster` gets the
# largest share on top of that because an A0 render is the single most
# memory-heavy thing this app does.
#
# These four limits sum to ~3.25 GB — on the documented 4 GB VPS
# (docs/DEPLOYMENT_VPS.md), that leaves too little for the OS plus a second
# full stack (prod + val share one host there). Halving everything is not a
# real fix once resolve alone measures >512M; treat "both stacks, generous
# limits, one 4 GB host" as an open capacity question, not solved by any
# number in this file — either give the host more RAM, or don't run both
# stacks' workers at full concurrency simultaneously.
x-mem-api: &mem-api
  memory: 768M
x-mem-worker: &mem-worker
  memory: 1024M
x-mem-worker-poster: &mem-worker-poster
  memory: 1280M
x-mem-redis: &mem-redis
  memory: 256M

services:
  # ── API ─────────────────────────────────────────────────────────────────────
  traxjourney:
    image: ghcr.io/rui-nar/traxjourney:latest
    container_name: traxjourney
    restart: unless-stopped
    ports:
      - "7777:8000"
    env_file: .env
    logging: *default-logging
    deploy:
      resources:
        limits: *mem-api
    volumes:
      - ./db:/app/db
      - ./config:/app/config
      - ./data:/app/data
      # Only needed when PROMETHEUS_MULTIPROC_DIR is set — see below.
      - ./metrics:/app/metrics
    # This container owns the schema: its lifespan runs `alembic upgrade head`.
    # The worker deliberately does not (issue #173).
    depends_on:
      redis:
        condition: service_healthy

  # ── Background job workers ──────────────────────────────────────────────────
  # OPTIONAL. Delete both worker services (and REDIS_URL from .env) and every
  # background job runs inside the API process via FastAPI BackgroundTasks — the
  # original behaviour, and a perfectly reasonable setup for a small instance.
  #
  # Running them buys durability (a job survives an API restart instead of
  # leaving e.g. a segment stuck on "calculating route") and a real concurrency
  # bound.
  #
  # WHY TWO SERVICES RATHER THAN ONE WITH `deploy.replicas: 2`
  # An RQ worker runs ONE job at a time, so the number of processes listening on
  # a queue IS that queue's parallelism. Identical replicas can only ever give
  # every queue the same bound, and the bounds are not the same (issue #188):
  #
  #   resolve  2  Overpass rate-limits per IP, and it is a free public service.
  #               Raising this is a decision about load on someone else's
  #               infrastructure, not a throughput dial.
  #   poster   1  An A0 render is memory-heavy. Two at once is the OOM case that
  #               running workers outside the API container exists to contain.
  #   default  2  Share tiles and stats — short and cheap.
  #
  # These numbers are mirrored in QUEUE_MAX_CONCURRENCY in src/jobs/queue.py,
  # and tests/test_worker_topology.py fails if this file stops matching it.
  #
  # QUEUE ORDER IN `command` MATTERS: RQ checks the queues in the order given and
  # takes the first job it finds. Two rules, in this order:
  #   1. A service's dedicated queue comes first, so it cannot starve. Only
  #      worker-poster consumes `poster`; if `poster` came last there, a busy
  #      `resolve` queue would leave a user waiting on a render indefinitely.
  #   2. Otherwise cheapest first, so a 1 s share tile is not stuck behind a
  #      resolve, which can hold a worker for the full 600 s job timeout.
  #
  # Both services MUST stay on the same image tag as the API. They share one
  # image and only the API runs migrations, so a worker left on an older tag
  # would execute stale job code against a schema it does not know about.
  # `docker compose pull && up -d` keeps them in step; pinning one does not.

  # Cheap queues only. Never renders a poster.
  worker:
    image: ghcr.io/rui-nar/traxjourney:latest
    container_name: traxjourney-worker
    restart: unless-stopped
    command: ["/worker-entrypoint.sh", "default", "resolve"]
    env_file: .env
    environment:
      TRAXJOURNEY_ROLE: worker
    logging: *default-logging
    deploy:
      resources:
        limits: *mem-worker
    volumes:
      # MUST be the same host paths as the API container: the database is a
      # SQLite file, so "sharing" it means sharing the volume, on one host.
      - ./db:/app/db
      - ./config:/app/config
      - ./data:/app/data
      - ./metrics:/app/metrics
    depends_on:
      redis:
        condition: service_healthy

  # The ONLY consumer of `poster`, which is what keeps A0 renders serial. Do not
  # add a second instance of this service and do not add `poster` to the service
  # above. It also drains the cheap queues when no poster is pending, so it is
  # the second `resolve`/`default` consumer rather than a mostly-idle container.
  worker-poster:
    image: ghcr.io/rui-nar/traxjourney:latest
    container_name: traxjourney-worker-poster
    restart: unless-stopped
    command: ["/worker-entrypoint.sh", "poster", "default", "resolve"]
    env_file: .env
    environment:
      TRAXJOURNEY_ROLE: worker
    logging: *default-logging
    deploy:
      resources:
        limits: *mem-worker-poster
    volumes:
      - ./db:/app/db
      - ./config:/app/config
      - ./data:/app/data
      - ./metrics:/app/metrics
    depends_on:
      redis:
        condition: service_healthy

  # ── Broker ──────────────────────────────────────────────────────────────────
  # Not published to the host: only the other services on this network need it,
  # and an exposed Redis with no auth is a well-known way to lose a server.
  # Note Docker publishes ports by punching through ufw, so "the firewall blocks
  # it" is not a substitute for simply not publishing it.
  redis:
    image: redis:7-alpine
    container_name: traxjourney-redis
    restart: unless-stopped
    # appendonly: queued jobs survive a Redis restart. Without it a broker
    # bounce silently drops every in-flight job — the exact failure the queue
    # was introduced to fix.
    command: ["redis-server", "--appendonly", "yes"]
    logging: *default-logging
    deploy:
      resources:
        limits: *mem-redis
    volumes:
      - ./redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # ── Observability shipper (optional, issue #205) ────────────────────────────
  # Ships this host's container logs + app metrics to Loki/Prometheus running
  # on the NAS — see docs/OBSERVABILITY.md for the NAS-side stack and
  # docs/DEPLOYMENT_VPS.md's "Observability" section for the Tailscale tunnel
  # this depends on. Delete this service (and the two env keys below) to run
  # without it; nothing else in this file depends on it, and dropping it just
  # means falling back to local `docker compose logs` + Dozzle (already
  # deployed separately) for everything.
  #
  # Reaches the API over the compose-internal network by service name
  # (traxjourney:8000) — /metrics is never published to the host or the
  # internet for this to work, only to the other containers on this network.
  #
  # NOT verified against a live Alloy binary from the session that wrote this
  # — config/alloy-config.river.example is a documented starting point to
  # adapt, in the same spirit docker-compose.yml.example itself already is.
  alloy:
    image: grafana/alloy:latest
    container_name: traxjourney-alloy
    restart: unless-stopped
    env_file: .env
    logging: *default-logging
    volumes:
      - ./config/alloy-config.river:/etc/alloy/config.river:ro
      # Read-only — how loki.source.docker discovers and tails every
      # container's logs without a bind-mounted log file per service. Nothing
      # about this container listens inward, so this is a read capability
      # leaving the host, not an attack surface being opened on it.
      - /var/run/docker.sock:/var/run/docker.sock:ro
      # Host /proc, /sys and / for prometheus.exporter.unix (issue #209 — no
      # visibility into host memory/swap was why that incident looked like
      # silence instead of a clean crash). Without these, the container's own
      # namespaced /proc is what gets read instead of the host's, which is
      # good enough for some fields but not a reliable memory/swap picture.
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
    command:
      - "run"
      - "--server.http.listen-addr=127.0.0.1:12345"
      - "/etc/alloy/config.river"
    depends_on:
      - traxjourney

# Relevant .env keys for the above (see .env.example for the full list):
#
#   REDIS_URL=redis://redis:6379/0
#     Enables the queue. Unset it (and drop the worker services) to run every
#     job in-process. This is the rollback path — no image rebuild needed.
#
#   PROMETHEUS_MULTIPROC_DIR=/app/metrics
#     Only if you scrape /metrics AND run the workers. Without it a scrape sees
#     the API process only, so job-side DB metrics silently go missing. Leave
#     unset when there are no workers.
#
#   LOKI_PUSH_URL=http://<nas-tailscale-host>:3100/loki/api/v1/push
#   PROMETHEUS_REMOTE_WRITE_URL=http://<nas-tailscale-host>:9090/api/v1/write
#     Read by config/alloy-config.river via env(). Only needed if you run the
#     alloy service above — see docs/OBSERVABILITY.md and
#     docs/DEPLOYMENT_VPS.md's "Observability" section.
