[Unit]
Description=adnanh/webhook — GitHub workflow_run listener (auto-deploy validation, issue #205)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/webhook -hooks /opt/traxjourney-val/webhook/hooks.yaml -port 9999 -verbose
Restart=on-failure
RestartSec=5
User=debian

[Install]
WantedBy=multi-user.target
