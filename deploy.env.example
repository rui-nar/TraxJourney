# deploy.ps1 settings: where the validation and prod environments live.
#
# Copy this file to deploy.env (gitignored) and fill in the blanks. deploy.ps1
# reads it with the same rules as .env (Load-DotEnv.ps1) and stops, naming the
# key, if a value it needs is empty.
#
# This is not the server's .env. Nothing here reaches a container; the host's
# own <dir>/.env configures the running app.

# ── SSH ───────────────────────────────────────────────────────────────────────
# Host (name or IP) that runs both environments' docker compose projects.
DEPLOY_HOST=
DEPLOY_SSH_PORT=22
# Account on that host allowed to run docker.
DEPLOY_USER=
# Private key for that account. A leading ~ means your home directory.
DEPLOY_SSH_KEY=~/.ssh/traxjourney_vps

# ── Image ─────────────────────────────────────────────────────────────────────
# Repository without a tag: validation deploys :validation, prod deploys :latest.
# The host's docker-compose.yml must name the same image, or the deploy stops.
DEPLOY_IMAGE=ghcr.io/rui-nar/traxjourney

# ── Environments ──────────────────────────────────────────────────────────────
# Compose directory on the host, and the public URL that directory serves.
# The URL is where the deploy checks /api/version afterwards.
DEPLOY_VAL_DIR=/opt/traxjourney-val
DEPLOY_VAL_URL=https://val.traxjourney.com
DEPLOY_PROD_DIR=/opt/traxjourney
DEPLOY_PROD_URL=https://traxjourney.com

# ── Web build ─────────────────────────────────────────────────────────────────
# Mapbox public token (pk....) baked into the web client when deploy.ps1 builds
# it (validation without -SkipBuild). Same name as the MAPBOX_TOKEN secret
# docker-build.yml uses for CI's builds. -MapboxToken overrides it.
MAPBOX_TOKEN=
