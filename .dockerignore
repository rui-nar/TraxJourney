# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Reflex frontend (no longer used)
.web/

# Flutter client (built separately, not part of the API image)
flutter_client/

# Dev / local files
.git/
.claude/
*.db
data/
docs/
tests/
scripts/
# ...except the scripts that run *in* the image. The rail data refresh is
# `docker compose run --rm --entrypoint python traxjourney
# scripts/fetch_rail_data.py` (issue #345), and the read-only audits are run
# the same way against each instance's database after a deploy (#468, #471),
# so these files have to be in the build context. Must stay after `scripts/`:
# docker's last matching pattern wins.
!scripts/fetch_rail_data.py
!scripts/audit_activity_ownership.py
!scripts/audit_photo_names.py

# Secrets
config/config.json

# OSM extracts and the rail pipeline's output (issue #345). Built in CI,
# fetched at boot, never baked into an image — a data refresh must not need a
# code release.
*.osm.pbf
dist/
