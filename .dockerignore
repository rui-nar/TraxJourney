# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Reflex frontend (no longer used)
.web/

# Flutter client (built separately, not part of the API image)
flutter_client/

# Dev / local files
.git/
.claude/
*.db
data/
docs/
tests/
scripts/
# ...except the one script that runs *in* the image: the rail data refresh is
# `docker compose run --rm --entrypoint python traxjourney
# scripts/fetch_rail_data.py` (issue #345), so the file has to be in the build
# context. Must stay after `scripts/`: docker's last matching pattern wins.
!scripts/fetch_rail_data.py

# Secrets
config/config.json

# OSM extracts and the rail pipeline's output (issue #345). Built in CI,
# fetched at boot, never baked into an image — a data refresh must not need a
# code release.
*.osm.pbf
dist/
