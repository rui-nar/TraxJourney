// Grafana Alloy config — ships this host's container logs and the app's
// Prometheus metrics to Loki/Prometheus colocated on the NAS (issue #205).
// See docs/OBSERVABILITY.md for the NAS-side stack these push to, and
// docs/DEPLOYMENT_VPS.md's "Observability" section for the Tailscale tunnel
// LOKI_PUSH_URL / PROMETHEUS_REMOTE_WRITE_URL point across.
//
//   cp config/alloy-config.river.example config/alloy-config.river
//
// No secrets belong in this file — both endpoint URLs come from .env via
// env(), read by the `alloy` service in docker-compose.yml.example.
//
// NOT verified against a live Alloy binary from the session that wrote this —
// treat it as a documented starting point to adapt and test against your own
// Loki/Prometheus, the same spirit docker-compose.yml.example itself already
// is for the app containers.
//
// PROD AND VAL SHARE THIS FILE, UNCHANGED, ONE PER HOST DIRECTORY. Both push
// to the same NAS Loki/Prometheus, so every series and log stream carries an
// `env` label (TRAXJOURNEY_ENV in .env — "production" or "validation", see
// docs/DEPLOYMENT_VPS.md §5) or the two deployments' data would be
// indistinguishable once it lands here. Every dashboard's `env` variable
// filters on exactly this label.

// Discover every container on this host via the Docker socket (read-only —
// see the volume mount in docker-compose.yml.example) so new services (a
// future worker, say) are picked up automatically with no config change here.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Static labels every discovered container needs before being tailed:
// `service` so the app's log stream has a stable name to query regardless of
// which container/environment emitted it, and `env` so prod and val are
// distinguishable once both land in the same Loki.
//
// Alloy's own container is dropped before either label is applied — not
// narrowed to a different label, dropped entirely. Confirmed live: without
// this, Alloy's own diagnostics ("disabling udev device properties" and
// friends) show up mislabeled service="traxjourney" in the Logs dashboard's
// "All logs" panel, mixed in with the app's actual logs. Alloy is the one
// container that's structurally unmonitorable through this pipeline anyway
// — if Alloy itself is broken, it can't ship logs about being broken
// through the pipe it's responsible for shipping, so there's no version of
// "give it its own service label instead" that would actually work; a
// broken Alloy needs `docker compose logs alloy` on the host, not a Loki
// query. Everything else — Redis, the worker, worker-poster, any future
// service — deliberately keeps the blanket, ungated rule below and lands
// under service="traxjourney" same as the app itself: they're all part of
// what "the app" means operationally, and a failure in any of them is
// exactly the kind of thing the Logs dashboard exists to surface. New
// services need no config change here to be covered, same as discovery
// itself needs none above.
//
// `env` has no gate at all — every container, Alloy included, needs it to
// stay distinguishable from the other environment sharing this NAS.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/traxjourney-(val-)?alloy$"
    action        = "drop"
  }
  rule {
    target_label = "service"
    replacement  = "traxjourney"
  }
  rule {
    target_label = "env"
    replacement  = env("TRAXJOURNEY_ENV")
  }
}

// Tail every discovered container's stdout/stderr and forward to Loki. This
// is what actually reads the logs — the json-file rotation configured on
// each service in docker-compose.yml.example is the separate, independent
// fallback for when this pipeline (or the NAS/tunnel) is down.
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.nas.receiver]
}

loki.write "nas" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }

  // Bounded local write-ahead log: a NAS or tunnel outage (home power cut, a
  // DSM update reboot) buffers here and retries rather than blocking the app
  // or growing without limit on this host's disk. Tune down if disk is
  // tighter than expected; the app's own rotated container logs are still
  // the fallback of last resort either way.
  wal {
    max_segment_age = "1h"
  }
}

// Scrape the API's /metrics over the compose-internal network by service
// name — never published to the host or the internet for this to work, only
// reachable from other containers on this same compose network. `env` here
// is a literal target label (not discovery-derived, unlike the log labels
// above), since this target list is already hand-written.
//
// /metrics requires Authorization: Bearer <METRICS_TOKEN> unconditionally
// (docs/METRICS.md) — there's no exemption for same-network requests, so
// this scrape needs it same as any external one would. Without it, every
// scrape 401s; confirmed live via up{job="traxjourney"} == 0 with this
// argument absent. .env already reaches this container (env_file: .env,
// docker-compose.yml.example), so no separate wiring needed beyond this.
prometheus.scrape "traxjourney" {
  targets = [
    {"__address__" = "traxjourney:8000", "job" = "traxjourney", "env" = env("TRAXJOURNEY_ENV")},
  ]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  bearer_token    = env("METRICS_TOKEN")
  forward_to      = [prometheus.remote_write.nas.receiver]
}

// Host memory/swap/CPU/disk — the visibility that was missing during issue
// #209: the VPS livelocked under memory pressure with no swap, and every log
// checked in that investigation was silent because nothing on the host was
// watching memory at all. Same node_exporter collectors, same metric names
// (node_memory_*, node_load*, ...), pointed at the host's real /proc and /sys
// via the mounts in docker-compose.yml.example rather than this container's
// own namespaced view — without those mounts this still runs, it just
// reports the container's own limited view instead of the host's.
//
// Prod and val each run this on the SAME physical VPS, so both push what is
// genuinely the same host data — deliberately not deduplicated (that would
// need coordinating which of the two instances is allowed to report, for no
// real benefit at this scale). The `env` label keeps the two writers from
// colliding as the same series, and a gap in one environment's host data
// while the other's keeps reporting is itself a useful signal that that
// environment's alloy container, specifically, is down.
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "env"
    replacement  = env("TRAXJOURNEY_ENV")
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.nas.receiver]
}

prometheus.remote_write "nas" {
  endpoint {
    url = env("PROMETHEUS_REMOTE_WRITE_URL")
  }
}
