{
  "uid": "traxjourney-integrations-auth",
  "title": "TraxJourney / Integrations & Auth",
  "description": "Third-party API outcomes, Strava's own quota, and login/registration activity (docs/METRICS.md). Strava counts every retry attempt, since each one spends real quota. Use the env variable to view prod or val separately — they share this NAS.",
  "tags": ["traxjourney"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": {"query": "label_values(up{job=\"traxjourney\"}, env)", "refId": "EnvVariable"},
        "current": {"text": "production", "value": "production"},
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Strava quota used (15 min window)",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * traxjourney_strava_rate_limit_usage{window=\"15min\",env=\"$env\"} / traxjourney_strava_rate_limit_capacity{window=\"15min\",env=\"$env\"}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 100}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Strava quota used (daily window)",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * traxjourney_strava_rate_limit_usage{window=\"daily\",env=\"$env\"} / traxjourney_strava_rate_limit_capacity{window=\"daily\",env=\"$env\"}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 100}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Strava throttled/sec (our limiter)",
      "description": "Calls our own limiter refused before reaching Strava — distinct from outcome=rate_limited, which means Strava itself returned a 429.",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_strava_throttled_total{env=\"$env\"}[15m])) by (window)", "legendFormat": "{{window}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "decimals": 4}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Login failure rate",
      "description": "Credential stuffing signal — docs/METRICS.md alerts table.",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_logins_total{result=\"failure\",env=\"$env\"}[5m]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops", "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 0.05},
            {"color": "red", "value": 0.2}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External requests by service & outcome",
      "description": "outcome: success, client_error, auth_error, rate_limited, server_error, exception.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_external_requests_total{env=\"$env\"}[5m])) by (service, outcome)", "legendFormat": "{{service}} ({{outcome}})"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "External request duration (p95) by service",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(traxjourney_external_request_duration_seconds_bucket{env=\"$env\"}[5m])) by (le, service))", "legendFormat": "{{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Logins by provider & result",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_logins_total{env=\"$env\"}[15m])) by (provider, result)", "legendFormat": "{{provider}} ({{result}})"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "/failure/"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Registrations by provider",
      "description": "Google sign-in has no separate sign-up call, so this fires on first sight of a Google account and never again.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_registrations_total{env=\"$env\"}[1h])) by (provider)", "legendFormat": "{{provider}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "bars", "fillOpacity": 30}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "App opens by session state",
      "description": "\"Returnability\": every app launch, not just fresh credential submissions. resumed = cached session still valid, login_required = had to sign in from scratch.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(traxjourney_app_opens_total{env=\"$env\"}[15m])) by (session_state)", "legendFormat": "{{session_state}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}}, "overrides": [
        {"matcher": {"id": "byRegexp", "options": "/login_required/"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}
    }
  ]
}
