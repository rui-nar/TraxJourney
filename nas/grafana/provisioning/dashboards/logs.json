{
  "uid": "traxjourney-logs",
  "title": "TraxJourney / Logs",
  "description": "Loki queries mirroring docs/OBSERVABILITY.md. request_id= and user_id= are real logfmt tokens; %(levelname)s is positional, not a level= key, so level filtering is a substring match. Edit a panel's query and add e.g. |= \"request_id=<id>\" to reconstruct one request end to end. Use the env variable to view prod or val separately — they share this NAS.",
  "tags": ["traxjourney"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {"type": "loki", "uid": "$datasource"},
        "query": {"query": "label_values(env)", "refId": "EnvVariable"},
        "current": {"text": "production", "value": "production"},
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Error rate",
      "description": "sum(rate({service=\"traxjourney\", env=\"$env\"} |= \"ERROR\" [5m]))",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "loki", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate({service=\"traxjourney\", env=\"$env\"} |= \"ERROR\" [5m]))", "legendFormat": "ERROR lines/sec"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "External call failures by service",
      "description": "sum(rate({service=\"traxjourney\", env=\"$env\"} |= \"external call failed\" | logfmt [5m])) by (service) — matches track_external()'s log format, src/utils/metrics.py.",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "loki", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "sum(rate({service=\"traxjourney\", env=\"$env\"} |= \"external call failed\" | logfmt [5m])) by (service)", "legendFormat": "{{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 15, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["sum"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Recent errors",
      "description": "{service=\"traxjourney\", env=\"$env\"} |= \"ERROR\" — add |= \"request_id=<id>\" or |= \"user_id=<id>\" to narrow to one request/session.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 7},
      "datasource": {"type": "loki", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "{service=\"traxjourney\", env=\"$env\"} |= \"ERROR\""}
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "All logs (logfmt-parsed)",
      "description": "{service=\"traxjourney\", env=\"$env\"} | logfmt — the raw firehose. Filter in the query editor by request_id/user_id to reconstruct one request or one user's session across concurrent traffic.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "{service=\"traxjourney\", env=\"$env\"} | logfmt"}
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    }
  ]
}
