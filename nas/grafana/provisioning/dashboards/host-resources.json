{
  "uid": "traxjourney-host-resources",
  "title": "TraxJourney / Host Resources",
  "description": "VPS host memory, swap, CPU, disk and load, from Alloy's prometheus.exporter.unix (config/alloy-config.river.example). Added after issue #209: the host livelocked under memory pressure with no swap, and nothing was watching host resources at all, so the incident looked like silence rather than a clean crash. Prod and val run on the same physical VPS, so this dashboard reports the same host either way — use the env variable to pick which environment's alloy container is reporting it (a gap in one while the other keeps reporting is itself a useful signal).",
  "tags": ["traxjourney"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": {"query": "label_values(node_memory_MemTotal_bytes, env)", "refId": "EnvVariable"},
        "current": {"text": "production", "value": "production"},
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Memory used",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{env=\"$env\"} / node_memory_MemTotal_bytes{env=\"$env\"})"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 92}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Swap used",
      "description": "0/0 (no data) means no swap is configured — the exact state that turned issue #209 into a 43-hour livelock instead of a clean OOM-kill.",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - node_memory_SwapFree_bytes{env=\"$env\"} / node_memory_SwapTotal_bytes{env=\"$env\"})"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 50},
            {"color": "red", "value": 85}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Swap configured",
      "description": "node_memory_SwapTotal_bytes > 0. If this reads 0 / red, the host has no cushion for a memory spike — see issue #209.",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_memory_SwapTotal_bytes{env=\"$env\"}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "green", "value": 1}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory breakdown",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_memory_MemTotal_bytes{env=\"$env\"}", "legendFormat": "total"},
        {"refId": "B", "expr": "node_memory_MemAvailable_bytes{env=\"$env\"}", "legendFormat": "available"},
        {"refId": "C", "expr": "node_memory_MemFree_bytes{env=\"$env\"}", "legendFormat": "free"},
        {"refId": "D", "expr": "node_memory_Cached_bytes{env=\"$env\"}", "legendFormat": "cached"},
        {"refId": "E", "expr": "node_memory_Buffers_bytes{env=\"$env\"}", "legendFormat": "buffers"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 5}}, "overrides": [
        {"matcher": {"id": "byName", "options": "total"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10]}}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "min", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Swap used over time",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_memory_SwapTotal_bytes{env=\"$env\"} - node_memory_SwapFree_bytes{env=\"$env\"}", "legendFormat": "swap used"},
        {"refId": "B", "expr": "node_memory_SwapTotal_bytes{env=\"$env\"}", "legendFormat": "swap total"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": [
        {"matcher": {"id": "byName", "options": "swap total"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10]}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "TraxJourney API process RSS",
      "description": "process_resident_memory_bytes for the traxjourney job — the app's own view of its memory, from prometheus_client's default collector. Empty if PROMETHEUS_MULTIPROC_DIR is set (worker containers running, docs/DEPLOYMENT_VPS.md): multiprocess mode doesn't aggregate this metric across processes. Host memory above is the reliable signal either way.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "process_resident_memory_bytes{job=\"traxjourney\",env=\"$env\"}", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "CPU used",
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",env=\"$env\"}[5m])))"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 95}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Load average (1m)",
      "description": "This VPS is 2 vCore — a sustained value above 2 means more is runnable than there is CPU to run it.",
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 24},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_load1{env=\"$env\"}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 2},
            {"color": "red", "value": 4}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "area"}
    },
    {
      "id": 9,
      "type": "gauge",
      "title": "Disk used (root filesystem)",
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 24},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",env=\"$env\"} / node_filesystem_size_bytes{mountpoint=\"/\",env=\"$env\"})"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 80},
            {"color": "red", "value": 92}
          ]}
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU usage by mode",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "avg(rate(node_cpu_seconds_total{env=\"$env\"}[5m])) by (mode)", "legendFormat": "{{mode}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 10, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Load average over time",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 31},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_load1{env=\"$env\"}", "legendFormat": "1m"},
        {"refId": "B", "expr": "node_load5{env=\"$env\"}", "legendFormat": "5m"},
        {"refId": "C", "expr": "node_load15{env=\"$env\"}", "legendFormat": "15m"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "line", "fillOpacity": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Disk space (root filesystem)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40},
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "targets": [
        {"refId": "A", "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",env=\"$env\"}", "legendFormat": "free"},
        {"refId": "B", "expr": "node_filesystem_size_bytes{mountpoint=\"/\",env=\"$env\"}", "legendFormat": "total"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 5}}, "overrides": [
        {"matcher": {"id": "byName", "options": "total"}, "properties": [{"id": "custom.lineStyle", "value": {"dash": [10, 10]}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
