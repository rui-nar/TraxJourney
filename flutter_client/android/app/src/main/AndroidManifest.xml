<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The whole app talks to the API over the network. The Flutter template
         declares this in the debug/profile manifests only, which leaves a
         release build with no network access at all. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Device location for the encounter location picker (defaults to current position). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="TraxJourney"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Hand the incoming intent URL to the Flutter engine as a route,
                 which go_router picks up (see buildRouter's initialLocation). -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android App Links: the three link shapes a user receives out of
                 band — a shared trip, a trip invite, an email verification —
                 open in the app instead of the browser. autoVerify requires
                 https://traxjourney.com/.well-known/assetlinks.json to list this
                 package with the release keystore's SHA-256 (served by
                 api/router.py from ANDROID_CERT_FINGERPRINTS). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="traxjourney.com" android:pathPrefix="/share"/>
                <data android:scheme="https" android:host="traxjourney.com" android:pathPrefix="/join"/>
                <data android:scheme="https" android:host="traxjourney.com" android:pathPrefix="/verify-email"/>
            </intent-filter>
            <!-- The return from Strava consent in the system browser: the
                 server's OAuth callback redirects an app-started connect to
                 traxjourney://app/strava-return?…, which opens the app on
                 lib/src/settings/strava_return_screen.dart. A custom scheme,
                 not an App Link, so debug and val builds return too; another
                 app claiming the scheme gets nothing usable, because the code
                 is bound to a state bound to this app's verifier
                 (docs/STRAVA_CONNECT_BINDING_PLAN.md, D4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="traxjourney" android:host="app" android:pathPrefix="/strava-return"/>
            </intent-filter>
            <!-- A .gpx opened ("Open with") or shared from another app (issue
                 #368): Gmail, Files, a Chrome download, Komoot. MainActivity
                 holds the file for lib/src/projects/incoming_gpx.dart and keeps
                 its content:// address away from the router. Only GPX's own
                 types for now: application/octet-stream would list the app for
                 every binary file (see docs/TRIP_IMPORT_EXPORT_PLAN.md, Open
                 decisions). No scheme is given, so these match content: and
                 file: only, never an https link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/gpx"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/gpx+xml"/>
                <data android:mimeType="application/gpx"/>
                <data android:mimeType="text/xml"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
